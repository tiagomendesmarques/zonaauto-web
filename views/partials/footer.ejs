</main>
<footer class="site-footer">
  <div class="container footer-grid">
    <div>
      <img src="/static/img/logo-white.svg" alt="<%= stand.name %>" height="36" class="footer-logo">
      <p><%= stand.slogan %></p>
      <div class="social">
        <% if (stand.facebook) { %><a href="<%= stand.facebook %>" target="_blank" rel="noopener">Facebook</a><% } %>
        <% if (stand.instagram) { %><a href="<%= stand.instagram %>" target="_blank" rel="noopener">Instagram</a><% } %>
      </div>
    </div>
    <div>
      <h4>Navegação</h4>
      <a href="/viaturas">Viaturas</a><a href="/sobre">Sobre nós</a><a href="/contactos">Contactos</a>
    </div>
    <div>
      <h4>Contactos</h4>
      <% if (stand.address) { %><p><%= stand.address %></p><% } %>
      <% if (stand.phone) { %><p><a href="tel:<%= stand.phone.replace(/\s/g, '') %>"><%= stand.phone %></a></p><% } %>
      <% if (stand.email) { %><p><a href="mailto:<%= stand.email %>"><%= stand.email %></a></p><% } %>
    </div>
    <% if (stand.hours.length) { %>
    <div>
      <h4>Horário</h4>
      <% stand.hours.forEach(h => { %><p><%= h %></p><% }) %>
    </div>
    <% } %>
  </div>
  <div class="container footer-bottom">
    <span>© <%= new Date().getFullYear() %> <%= stand.name %>. Todos os direitos reservados.</span>
    <a href="https://www.livroreclamacoes.pt" target="_blank" rel="noopener">Livro de Reclamações</a>
  </div>
</footer>
<% const wa = whatsappLink('Olá! Vi o vosso site e gostaria de mais informações.'); if (wa) { %>
<a class="wa-float" href="<%= wa %>" target="_blank" rel="noopener" aria-label="WhatsApp">
  <svg viewBox="0 0 24 24" width="28" height="28" fill="currentColor"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm5.3 14.2c-.2.6-1.3 1.2-1.8 1.2-.5.1-1 .2-3.3-.7-2.8-1.1-4.6-4-4.7-4.2-.1-.2-1.1-1.5-1.1-2.9s.7-2 1-2.3c.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.5l.8 2c.1.2.1.4 0 .5l-.3.5-.4.4c-.1.1-.3.3-.1.6.2.3.8 1.3 1.7 2.1 1.1 1 2.1 1.3 2.4 1.5.3.1.5.1.6-.1l.9-1.1c.2-.3.4-.2.7-.1l1.9.9c.3.1.5.2.5.3.1.2.1.7-.1 1.2z"/></svg>
</a>
<% } %>
<script src="/static/js/app.js" defer></script>
</body>
</html>

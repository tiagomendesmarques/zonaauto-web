</main>
<footer class="site-footer on-dark">
  <div class="wrap footer-cta">
    <div>
      <p class="eyebrow">Atendimento por marcação</p>
      <h2 class="display">Marca já o teu test-drive.</h2>
    </div>
    <div class="band-actions">
      <a class="btn btn-wa" data-wa="rodape" href="<%= waLink('Olá! Gostaria de marcar uma visita ao stand.') %>" target="_blank" rel="noopener"><svg><use href="#i-wa"/></svg>Marcar por WhatsApp</a>
      <a class="btn btn-outline-light" href="<%= telHref(stand.phone) %>"><svg><use href="#i-phone"/></svg><span class="num"><%= stand.phone %></span></a>
    </div>
  </div>
  <div class="wrap footer-grid">
    <div class="footer-brand">
      <img src="/static/img/logo-branco.webp" alt="zonaauto.pt" width="160" height="48" loading="lazy">
      <p><%= stand.tagline %></p>
      <div class="socials">
        <a href="<%= stand.facebook %>" target="_blank" rel="noopener" aria-label="Facebook"><svg><use href="#i-fb"/></svg></a>
        <a href="<%= stand.instagram %>" target="_blank" rel="noopener" aria-label="Instagram"><svg><use href="#i-ig"/></svg></a>
      </div>
    </div>
    <div>
      <h3>Navegação</h3>
      <nav aria-label="Rodapé">
        <a href="/stock/">Stock</a>
        <a href="/importacao/">Importação</a>
        <a href="/contactos/">Contactos</a>
      </nav>
    </div>
    <div>
      <h3>Contactos</h3>
      <address>
        <a href="<%= mapsLink %>" target="_blank" rel="noopener"><%= stand.street %><br><%= stand.city %></a>
        <a href="<%= telHref(stand.phone) %>" class="num"><%= stand.phone %></a>
        <a href="mailto:<%= stand.email %>"><%= stand.email %></a>
      </address>
    </div>
    <div>
      <h3>Horário</h3>
      <div class="hours">
        <% for (let i = 0; i < stand.hours.length; i += 2) { %><span><%= stand.hours[i] %></span><span class="num"><%= stand.hours[i + 1] %></span><% } %>
      </div>
    </div>
  </div>
  <div class="wrap footer-bottom">
    <span>© <%= new Date().getFullYear() %> <%= stand.name %>. Todos os direitos reservados.</span>
    <nav aria-label="Legal">
      <a href="/termos-e-condicoes-de-utilizacao/">Termos e condições</a>
      <a href="/politica-de-privacidade/">Política de privacidade</a>
      <a href="https://www.livroreclamacoes.pt" target="_blank" rel="noopener">Livro de Reclamações</a>
    </nav>
  </div>
</footer>
<a class="wa-float" data-wa="botao_flutuante" href="<%= waLink(typeof waText !== 'undefined' && waText ? waText : 'Olá! Vi o vosso site e gostaria de mais informações.') %>" target="_blank" rel="noopener" aria-label="Falar connosco por WhatsApp"><svg><use href="#i-wa"/></svg></a>
<script src="/static/js/app.js" defer></script>
</body>
</html>

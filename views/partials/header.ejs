<!doctype html>
<html lang="pt-PT">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<%
  // seo (opcional): { fullTitle, keywords, ogType, ogImageAlt, article: { published, modified, tags }, noSuffix }
  const meta = typeof seo !== 'undefined' && seo ? seo : {};
  const pageTitle = meta.fullTitle || (typeof title !== 'undefined' ? title + ' | ' + stand.name : stand.name + ' | Carros usados em Lisboa');
  const pageDesc = typeof description !== 'undefined' && description ? description : 'Encontra, compara e escolhe o carro ideal com total confiança. Viaturas com garantia, financiamento e retoma.';
  const pageImage = typeof ogImage !== 'undefined' && ogImage ? ogImage : siteUrl + '/static/img/hero-home.webp';
  const canonical = siteUrl + (typeof reqPath !== 'undefined' ? reqPath : '/');
%>
  <title><%= pageTitle %></title>
  <meta name="description" content="<%= pageDesc %>">
  <link rel="canonical" href="<%= canonical %>">
  <% if (meta.keywords && meta.keywords.length) { %><meta name="keywords" content="<%= meta.keywords.join(', ') %>"><% } %>
  <meta property="og:title" content="<%= meta.fullTitle || (typeof title !== 'undefined' ? title : stand.name) %>">
  <meta property="og:description" content="<%= pageDesc %>">
  <meta property="og:type" content="<%= meta.ogType || 'website' %>">
  <meta property="og:url" content="<%= canonical %>">
  <meta property="og:site_name" content="<%= stand.name %>">
  <meta property="og:locale" content="pt_PT">
  <meta property="og:image" content="<%= pageImage %>">
  <% if (meta.ogImageAlt) { %><meta property="og:image:alt" content="<%= meta.ogImageAlt %>"><% } %>
  <% if (meta.article) { %>
  <% if (meta.article.published) { %><meta property="article:published_time" content="<%= meta.article.published.toISOString() %>"><% } %>
  <% if (meta.article.modified) { %><meta property="article:modified_time" content="<%= meta.article.modified.toISOString() %>"><% } %>
  <% (meta.article.tags || []).forEach((t) => { %><meta property="article:tag" content="<%= t %>"><% }) %>
  <% } %>
  <meta name="twitter:card" content="<%= meta.twitterCard || 'summary_large_image' %>">
  <meta name="twitter:title" content="<%= meta.fullTitle || (typeof title !== 'undefined' ? title : stand.name) %>">
  <meta name="twitter:description" content="<%= pageDesc %>">
  <% if (meta.twitterCard !== 'summary') { %><meta name="twitter:image" content="<%= pageImage %>"><% } %>
  <% if (typeof hasBlog !== 'undefined' && hasBlog) { %><link rel="alternate" type="application/rss+xml" title="Blog <%= stand.name %>" href="/feed/"><% } %>
  <meta name="theme-color" content="#0e001e">
  <% if (gtmId) { %><script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','<%= gtmId %>');</script><% } %>
  <link rel="icon" href="/static/img/favicon.png" sizes="32x32">
  <link rel="apple-touch-icon" href="/static/img/icon-192.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Archivo:ital,wdth,wght@0,100..125,400..900;1,100..125,400..900&family=Figtree:wght@400..700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/static/css/style.css?v=<%= assetVersion %>">
  <% (typeof extraCss !== 'undefined' ? extraCss : []).forEach((f) => { %><link rel="stylesheet" href="/static/css/<%= f %>?v=<%= assetVersion %>">
  <% }) %></head>
<body<% if (typeof viatura !== 'undefined' && viatura) { %> data-viatura="<%= viatura.nome %>" data-valor="<%= viatura.valor || '' %>"<% } %>>
<% if (gtmId) { %><noscript><iframe src="https://www.googletagmanager.com/ns.html?id=<%= gtmId %>" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript><% } %>
<%- include('icons') %>
<header class="site-header">
  <div class="wrap header-inner">
    <a href="/" class="logo" aria-label="<%= stand.name %>, página inicial"><img src="/static/img/logo-branco.webp" alt="zonaauto.pt" width="146" height="44"></a>
    <nav class="main-nav" aria-label="Principal">
      <a href="/" <%- page === 'home' ? 'aria-current="page"' : '' %>>Início</a>
      <a href="/stock/" <%- page === 'stock' ? 'aria-current="page"' : '' %>>Stock</a>
      <a href="/importacao/" <%- page === 'importacao' ? 'aria-current="page"' : '' %>>Importação</a>
      <a href="/apoio-eletrico/" <%- page === 'apoio' ? 'aria-current="page"' : '' %>>Apoio elétrico</a>
      <% if (typeof hasBlog !== 'undefined' && hasBlog) { %><a href="/blog/" <%- page === 'blog' ? 'aria-current="page"' : '' %>>Blog</a><% } %>
      <a href="/contactos/" <%- page === 'contactos' ? 'aria-current="page"' : '' %>>Contactos</a>
    </nav>
    <%- phoneLink('header-phone', 'circulo') %>
    <button class="nav-toggle" type="button" aria-label="Abrir menu" aria-expanded="false"><svg><use href="#i-menu"/></svg></button>
  </div>
</header>
<main>

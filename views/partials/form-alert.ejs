<% if (sent === 'ok') { %>
  <div class="alert ok" role="status"><strong>Pedido enviado.</strong>Obrigado! Vamos responder-te o mais depressa possível.</div>
<% } else if (sent === 'missing') { %>
  <div class="alert warn" role="alert">Preenche os campos obrigatórios assinalados com *.</div>
<% } else if (sent === 'whatsapp') { %>
  <div class="alert warn" role="alert">Não foi possível enviar o pedido por email. Envia-o por WhatsApp, a mensagem já vai escrita:<a class="btn btn-wa" href="<%= waLink(waText) %>" target="_blank" rel="noopener"><svg><use href="#i-wa"/></svg>Enviar por WhatsApp</a></div>
<% } %>

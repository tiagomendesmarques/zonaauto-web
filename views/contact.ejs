<%- include('partials/header', { title: 'Contactos' }) %>
<section class="page-head"><div class="container"><h1>Contactos</h1><p>Visite-nos ou fale connosco.</p></div></section>
<section class="section">
  <div class="container contact-grid">
    <div class="contact-cards">
      <% if (stand.address) { %><div class="contact-card"><h3>📍 Morada</h3><p><%= stand.address %></p></div><% } %>
      <% if (stand.phone) { %><div class="contact-card"><h3>📞 Telefone</h3><p><a href="tel:<%= stand.phone.replace(/\s/g, '') %>"><%= stand.phone %></a></p></div><% } %>
      <% if (stand.email) { %><div class="contact-card"><h3>✉️ Email</h3><p><a href="mailto:<%= stand.email %>"><%= stand.email %></a></p></div><% } %>
      <% if (stand.hours.length) { %><div class="contact-card"><h3>🕒 Horário</h3><% stand.hours.forEach(h => { %><p><%= h %></p><% }) %></div><% } %>
      <% const wa = whatsappLink('Olá! Gostaria de mais informações.'); if (wa) { %><a class="btn btn-wa" href="<%= wa %>" target="_blank" rel="noopener">Falar por WhatsApp</a><% } %>
    </div>
    <div class="map">
      <% if (stand.mapsEmbedUrl) { %>
        <iframe src="<%= stand.mapsEmbedUrl %>" loading="lazy" referrerpolicy="no-referrer-when-downgrade" title="Mapa"></iframe>
      <% } else if (stand.address) { %>
        <iframe src="https://www.google.com/maps?q=<%= encodeURIComponent(stand.address) %>&output=embed" loading="lazy" title="Mapa"></iframe>
      <% } %>
    </div>
  </div>
</section>
<%- include('partials/footer') %>
